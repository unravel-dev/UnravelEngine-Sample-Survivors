using Unravel.Core;

namespace Survivors
{
    /// <summary>
    /// The Barbarian's palette: warm steel axes and dust, blood-red Fury and the crimson of his evolutions. The
    /// Barbarian throws no projectiles, so he has no particle heads (his chains and fissures are drawn with particles).
    /// </summary>
    internal static class BarbarianLooks
    {
        /// <summary>Warm steel: axe arcs, leap streaks, sweep streaks.</summary>
        internal static readonly Color STEEL = new Color(0.95f, 0.86f, 0.72f, 1.0f);
        /// <summary>Full Fury: flames, embers, the body glow, the Fury streaks of bloodied deaths.</summary>
        internal static readonly Color FURY_RED = new Color(1.0f, 0.12f, 0.06f, 1.0f);
        /// <summary>Skullsplitter's fissures and Maw of the Pit: crimson, darker than Fury.</summary>
        internal static readonly Color CRIMSON = new Color(0.95f, 0.14f, 0.09f, 1.0f);
        /// <summary>Sunlit dust of stomps and landings.</summary>
        internal static readonly Color DUST_GOLD = new Color(1.0f, 0.86f, 0.62f, 1.0f);
    }
}

namespace Survivors
{
    /// <summary>One HUD slot: a weapon or passive the hero owns.</summary>
    public struct SlotView
    {
        public string id;
        public string name;
        public string icon;
        public int rank;
        public int maxRank;
        public bool isEvolved;
        /// <summary>Rank max and paired passive owned: the next chest evolves it.</summary>
        public bool canEvolve;
        /// <summary>A short stat line for the pause sheet ("Damage 36, Cooldown 0.90 s, Radius 3.6 m, Swings 2").</summary>
        public string summary;
    }
}

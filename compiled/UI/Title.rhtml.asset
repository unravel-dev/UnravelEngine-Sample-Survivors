<html>
<head>
    <title>Barrowlight Title</title>
    <link type="text/rcss" href="engine:/data/ui/rml.rcss"/>
    <link type="text/rcss" href="app:/data/UI/theme.rcss"/>
    <link type="text/rcss" href="app:/data/UI/Title.rcss"/>
    <link type="text/rcss" href="app:/data/UI/phone.rcss"/>
</head>
<!--
    Title: the moor and the idle hero stay visible behind a side vignette. Model "title" is TitleModel
    (TitleScreen.cs): the banked gold, the best run, and the buttons' events.
-->
<body data-model="title" class="title">
    <div id="backdrop" class="fill"/>
    <div class="safe">
        <div id="intro">
            <img id="logo" src="app:/data/UI/Art/logo.png"/>
            <div id="tagline">FIFTEEN MINUTES. ONE HERO. THE BONE TIDE.</div>
            <div id="menu">
                <div id="play" class="btn primary nav" data-event-click="Play()">PLAY</div>
                <div id="armory" class="btn nav" data-event-click="Armory()">ARMORY<span class="menu-gold"><img class="glyph" src="app:/data/UI/Icons/gold.png"/><span>{{ gold }}</span></span></div>
                <div id="settings" class="btn nav" data-event-click="Settings()">SETTINGS</div>
                <div id="quit" class="btn nav no-touch" data-event-click="Quit()">QUIT</div>
            </div>
        </div>
        <div id="footer">
            <div id="best">{{ best }}</div>
            <div id="hints">
                <span class="kbd-only"><span class="keycap">ENTER</span> select <span class="keycap">ESC</span> back</span>
                <span class="pad-only"><img class="padglyph" src="app:/data/UI/Glyphs/buttonA.png"/> select <img class="padglyph" src="app:/data/UI/Glyphs/buttonB.png"/> back</span>
            </div>
        </div>
    </div>
</body>
</html>

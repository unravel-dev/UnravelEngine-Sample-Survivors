/* Overlay over the world. Lengths in rem; positions written by C# in dp. */

body.overlay { pointer-events: none; }

/* ---------- low health vignette and screen flash ---------- */

#vignette { opacity: 0; }

#vignette-img {
	decorator: image("app:/data/UI/Art/vignette.png");
}

#vignette-img.beat-slow { animation: 1s linear infinite heartbeat; }
#vignette-img.beat-fast { animation: 0.625s linear infinite heartbeat; }

@keyframes heartbeat {
	0% { image-color: #ffffff80; }
	12% { image-color: #ffffffff; }
	26% { image-color: #ffffff99; }
	40% { image-color: #ffffffe6; }
	100% { image-color: #ffffff80; }
}

/* A .flash-layer (theme.rcss); HeroVitals writes its opacity. */
#flash {
	background-color: #ffffff;
}

#flash.danger { background-color: #ff2a1a; }

/* ---------- damage numbers (pooled; DamageNumbers.cs writes left / top / opacity / transform) ---------- */

.dmg {
	position: absolute;
	left: 0;
	top: 0;
	width: 16rem;
	height: 3.6rem;
	margin-left: -8rem;
	margin-top: -1.8rem;
	text-align: center;
	font-family: "GT Display";
	font-size: 2.2rem;
	color: #ffffff;
	font-effect: outline(2dp #140c0c);
	visibility: hidden;
	white-space: nowrap;
}

.dmg.crit { font-size: 2.9rem; color: #ffe14a; font-effect: outline(2dp #2a1400); }
.dmg.burn { color: #ff9a3c; }
.dmg.frost { color: #8fe6ff; }
.dmg.echo { color: #c99bff; }
.dmg.heal { color: #6ef08a; font-size: 2.4rem; }
.dmg.hero { color: #ff4a3a; font-size: 2.6rem; font-effect: outline(2dp #1a0000); }
.dmg.word { width: 30rem; margin-left: -15rem; font-size: 2.6rem; letter-spacing: 0.25rem; }
.dmg.word.crit { font-size: 3rem; }

/* ---------- hero health bar above the head ---------- */

#herobar {
	position: absolute;
	left: 0;
	top: 0;
	width: 7rem;
	height: 0.9rem;
	margin-left: -3.5rem;
	border: 1dp #08060c;
	border-radius: 0.45rem;
	background-color: #0c0a12c0;
	visibility: hidden;
}

#herobar-fill {
	display: block;
	width: 100%;
	height: 100%;
	border-radius: 0.45rem;
	background-color: #00000000;
}

#herobar-fill fill { border-radius: 0.45rem; decorator: vertical-gradient(#8ff0a0 #2fae4a); }
#herobar.amber #herobar-fill fill { decorator: vertical-gradient(#ffd47a #d08a1a); }
#herobar.red #herobar-fill fill { decorator: vertical-gradient(#ff8a7a #c21e1e); }

/* ---------- elite health bars above heads (GameUI.ShowEliteBar) ---------- */

.elitebar {
	position: absolute;
	left: 0;
	top: 0;
	width: 6.4rem;
	height: 0.8rem;
	margin-left: -3.2rem;
	margin-top: -0.4rem;
	border: 1dp #ffc94c;
	border-radius: 0.4rem;
	background-color: #120a18d8;
	box-shadow: #b05cff60 0 0 0.6rem 0;
	visibility: hidden;
}

.elitebar-fill {
	display: block;
	width: 100%;
	height: 100%;
	border-radius: 0.4rem;
	background-color: #00000000;
}

.elitebar-fill fill {
	border-radius: 0.4rem;
	decorator: vertical-gradient(#d49bff #7a2ab8);
	border-right: 1dp #fff0c0;
}

/* ---------- off-screen markers ---------- */

.marker {
	position: absolute;
	left: 0;
	top: 0;
	width: 5.6rem;
	height: 5.6rem;
	margin-left: -2.8rem;
	margin-top: -2.8rem;
	visibility: hidden;
}

.marker-arrow {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	decorator: image("app:/data/UI/Art/marker.png");
	image-color: #ffb84a;
}

.marker.chest .marker-arrow { image-color: #ffd98a; }
.marker.boss .marker-arrow { image-color: #ff4a2a; }
.marker.treasure .marker-arrow { image-color: #ff3b4e; }
.marker.shrine .marker-arrow { image-color: #ffe6a8; }
.marker.robber .marker-arrow { image-color: #ffc247; }
.marker.pyres .marker-arrow { image-color: #78ff5c; }
.marker.moonwell .marker-arrow { image-color: #94d2ff; }

/* A chest on screen: a glowing gold badge with its icon bobs above it, over the horde, without the arrow. */
.marker.inview {
	border-radius: 2.8rem;
	background-color: #1a120ad8;
	border: 3dp #ffd98a;
	box-shadow: #ffc94c90 0 0 1.8rem 0.3rem;
	animation: 0.7s sine-in-out infinite alternate marker-bob;
}
.marker.inview .marker-arrow { visibility: hidden; }
.marker.inview.pyres { border-color: #78ff5c; box-shadow: #58ff4c90 0 0 1.8rem 0.3rem; }
.marker.inview.moonwell { border-color: #94d2ff; box-shadow: #6cc0ff90 0 0 1.8rem 0.3rem; }
.marker.inview .marker-icon {
	width: 3.8rem;
	height: 3.8rem;
	margin-left: -1.9rem;
	margin-top: -1.9rem;
}

@keyframes marker-bob {
	0% { transform: translateY(0rem) scale(1); }
	100% { transform: translateY(-0.9rem) scale(1.08); }
}

.marker-icon {
	position: absolute;
	left: 50%;
	top: 50%;
	width: 3rem;
	height: 3rem;
	margin-left: -1.5rem;
	margin-top: -1.5rem;
}

/* ---------- edge danger chevrons ---------- */

.edge {
	position: absolute;
	left: 0;
	top: 0;
	width: 9rem;
	height: 9rem;
	margin-left: -4.5rem;
	margin-top: -4.5rem;
	visibility: hidden;
}

.edge-chevrons {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	decorator: image("app:/data/UI/Art/chevron.png");
	animation: 0.35s sine-in-out infinite alternate chevron-pulse;
}

@keyframes chevron-pulse {
	0% { opacity: 0.35; transform: translateX(-0.8rem); }
	100% { opacity: 1; transform: translateX(0.8rem); }
}

/* ---------- boss bar (top center, 60% wide) ---------- */

#bossbar {
	position: absolute;
	top: 13rem;
	left: 20%;
	width: 60%;
	text-align: center;
	visibility: hidden;
}

/* Touch screens: top center, narrower (the HUD slots sit at the bottom center). */
body.touch #bossbar { left: 25%; width: 50%; }

#bossbar.shown {
	visibility: visible;
	animation: 0.6s cubic-out boss-in;
}

@keyframes boss-in {
	0% { opacity: 0; transform: translateY(-2rem) scale(1.05); }
	100% { opacity: 1; transform: translateY(0rem) scale(1); }
}

#boss-title {
	font-family: "GT Heavy";
	font-size: 1.3rem;
	letter-spacing: 0.6rem;
	color: #ff8a6a;
	font-effect: outline(2dp #1a0505);
}

#boss-name {
	font-family: "GT Display";
	font-size: 2.8rem;
	letter-spacing: 0.3rem;
	color: #ffe0c0;
	margin-bottom: 0.4rem;
	font-effect: outline(2dp #1a0505), glow(0dp 10dp 0dp 0dp #ff3a1a80);
}

#boss-frame {
	position: relative;
	height: 2.4rem;
	border: 2dp #6b5530;
	border-radius: 0.4rem;
	background-color: #0c0608e0;
	box-shadow: #000000c0 0 0.4rem 1.6rem 0, #ff3a1a40 0 0 2rem 0;
}

#boss-ghost, #boss-fill {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	background-color: #00000000;
}

#boss-ghost fill { background-color: #fff4e8; }
#boss-fill fill { decorator: vertical-gradient(#ff6a4a #a8101c); border-right: 2dp #ffd0c0; }

#boss-pips {
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
}

.boss-pip {
	position: absolute;
	top: -0.6rem;
	width: 1.4rem;
	height: 3.6rem;
	margin-left: -0.7rem;
}

.boss-pip-line {
	position: absolute;
	left: 0.6rem;
	top: 0.6rem;
	width: 0.2rem;
	height: 2.4rem;
	background-color: #ffc94c;
}

.boss-pip-gem {
	position: absolute;
	left: 0.25rem;
	top: -0.2rem;
	width: 0.9rem;
	height: 0.9rem;
	background-color: #ffc94c;
	border: 1dp #fff0c0;
	transform: rotate(45deg);
}

.boss-pip.broken .boss-pip-line, .boss-pip.broken .boss-pip-gem { background-color: #4a3a2a; border-color: #6b5530; }

#boss-shards {
	position: absolute;
	left: 50%;
	top: 0;
	width: 0;
	height: 2.4rem;
}

/* Transparent at rest: a finished animation hands opacity back to this rule. */
.shard {
	position: absolute;
	left: 0;
	top: 0.8rem;
	width: 0.9rem;
	height: 0.9rem;
	background-color: #ffc94c;
	opacity: 0;
	visibility: hidden;
}

#boss-shards.burst .shard { visibility: visible; }
#boss-shards.burst .s0 { animation: 0.6s cubic-out shard-0; }
#boss-shards.burst .s1 { animation: 0.6s cubic-out shard-1; }
#boss-shards.burst .s2 { animation: 0.6s cubic-out shard-2; }
#boss-shards.burst .s3 { animation: 0.6s cubic-out shard-3; }
#boss-shards.burst .s4 { animation: 0.6s cubic-out shard-4; }

@keyframes shard-0 { 0% { opacity: 1; transform: translate(0rem, 0rem) rotate(0deg); } 100% { opacity: 0; transform: translate(-4rem, -3.5rem) rotate(-200deg); } }
@keyframes shard-1 { 0% { opacity: 1; transform: translate(0rem, 0rem) rotate(0deg); } 100% { opacity: 0; transform: translate(3.5rem, -4rem) rotate(240deg); } }
@keyframes shard-2 { 0% { opacity: 1; transform: translate(0rem, 0rem) rotate(0deg); } 100% { opacity: 0; transform: translate(-2.5rem, 4rem) rotate(160deg); } }
@keyframes shard-3 { 0% { opacity: 1; transform: translate(0rem, 0rem) rotate(0deg); } 100% { opacity: 0; transform: translate(4.5rem, 3rem) rotate(-280deg); } }
@keyframes shard-4 { 0% { opacity: 1; transform: translate(0rem, 0rem) rotate(0deg); } 100% { opacity: 0; transform: translate(0.5rem, -5rem) rotate(120deg); } }

/* ---------- map event tracker (right, under the gold) ---------- */

#event {
	position: absolute;
	top: 10.5rem;
	right: 2rem;
	width: 30rem;
	padding: 0.8rem 1.2rem 1rem 1.4rem;
	decorator: horizontal-gradient(#0c0a1200 #0c0a12e0);
	border-right: 0.3rem #ffd98a;
	visibility: hidden;
}

#event.shown {
	visibility: visible;
	animation: 0.4s back-out event-in;
}

@keyframes event-in {
	0% { opacity: 0; transform: translateX(3rem); }
	100% { opacity: 1; transform: translateX(0rem); }
}

#event-head {
	display: flex;
	flex-direction: row;
	align-items: center;
}

#event-icon {
	width: 2.8rem;
	height: 2.8rem;
	margin-right: 0.8rem;
}

#event-title {
	flex: 1 1 auto;
	font-family: "GT Heavy";
	font-size: 1.6rem;
	letter-spacing: 0.2rem;
	white-space: nowrap;
	color: #ffd98a;
	font-effect: outline(2dp #140a04);
}

#event-time {
	font-size: 2rem;
	color: #ffffff;
	font-effect: outline(2dp #0c0a12);
}

#event-goal {
	margin: 0.4rem 0 0.6rem 0;
	font-size: 1.5rem;
	color: #ece4d4;
	font-effect: outline(2dp #0c0a12);
}

#event-frame {
	height: 1rem;
	border: 1dp #0a0810;
	border-radius: 0.5rem;
	background-color: #0c0a12d0;
}

#event-fill {
	display: block;
	width: 100%;
	height: 100%;
	border-radius: 0.5rem;
}

#event-fill fill {
	border-radius: 0.5rem;
	decorator: horizontal-gradient(#b8892e #ffe6a0);
}

#event.robber { border-color: #ffc247; }
#event.robber #event-title { color: #ffc247; }
#event.robber #event-fill fill { decorator: horizontal-gradient(#a8701c #ffd060); }
#event.pyres { border-color: #78ff5c; }
#event.pyres #event-title { color: #a8ff8c; }
#event.pyres #event-fill fill { decorator: horizontal-gradient(#2f8a24 #9aff7c); }
#event.moonwell { border-color: #94d2ff; }
#event.moonwell #event-title { color: #b8e2ff; }
#event.moonwell #event-fill fill { decorator: horizontal-gradient(#3a78b0 #b8e6ff); }
#event.won #event-title { color: #a8ff9a; }
#event.lost #event-title { color: #ff9a8a; }
#event.lost #event-fill fill { decorator: horizontal-gradient(#6a2018 #b04030); }

/* ---------- event banner (center top) ---------- */

#banner {
	position: absolute;
	top: 21.5rem;
	left: 0;
	right: 0;
	text-align: center;
	visibility: hidden;
}

#banner.shown {
	visibility: visible;
}

#banner-inner {
	display: inline-block;
	padding: 0.8rem 6rem;
	decorator: linear-gradient(to right, #0c0a1200, #0c0a12d8, #0c0a1200);
	animation: 0.4s back-out banner-in;
}

#banner-text {
	font-family: "GT Display";
	font-size: 3.8rem;
	letter-spacing: 0.5rem;
	color: #ffd98a;
	font-effect: outline(3dp #140a04), glow(0dp 14dp 0dp 0dp #ff8a3080);
}

#banner-line-top, #banner-line-bottom {
	height: 0.2rem;
	margin: 0.4rem 0;
	decorator: linear-gradient(to right, #c9a45c00, #c9a45cff, #c9a45c00);
}

#banner.warning #banner-text { color: #ffb0a0; font-effect: outline(3dp #1a0202), glow(0dp 14dp 0dp 0dp #ff2a1aa0); }
#banner.warning #banner-line-top, #banner.warning #banner-line-bottom { decorator: linear-gradient(to right, #ff4a2a00, #ff4a2aff, #ff4a2a00); }

@keyframes banner-in {
	0% { opacity: 0; transform: scale(1.3); }
	100% { opacity: 1; transform: scale(1); }
}

/* ---------- phone: boss bar at the top center under the timer, event tracker on the right, banner below ---------- */

body.phone #bossbar { top: 11.5rem; left: 25%; width: 50%; }
body.phone #boss-title { font-size: 1.5rem; letter-spacing: 0.4rem; }
body.phone #boss-name { font-size: 2.4rem; }
body.phone #banner { top: 21rem; }
body.phone #event { top: 12rem; right: 1.6rem; width: 26rem; }
body.phone #event-title { font-size: 1.7rem; letter-spacing: 0.1rem; }
body.phone #event-goal { font-size: 1.7rem; }
body.phone #event-time { font-size: 2.2rem; }
body.phone #banner-text { font-size: 3rem; letter-spacing: 0.3rem; }
body.phone #banner-inner { padding: 0.6rem 3rem; }

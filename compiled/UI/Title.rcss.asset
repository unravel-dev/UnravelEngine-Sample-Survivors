/* Title screen. Lengths in rem. The 3D moor shows through on the right. */

#backdrop {
	decorator: linear-gradient(to right, #07050af2, #07050ad0 35%, #07050a40 65%, #07050a00);
}

#intro {
	position: absolute;
	left: 10rem;
	top: 14rem;
	width: 64rem;
	animation: 0.6s cubic-out screen-in;
}

#logo {
	display: block;
	width: 64rem;
	height: 9rem;
	animation: 3s sine-in-out infinite alternate logo-breathe;
}

@keyframes logo-breathe {
	0% { image-color: #ffffffff; }
	100% { image-color: #ffe8c8ff; }
}

#tagline {
	margin: 1.4rem 0 5rem 0.6rem;
	font-family: "GT Semi";
	font-size: 1.6rem;
	letter-spacing: 0.6rem;
	color: #a99f8f;
}

#menu {
	width: 34rem;
}

#menu .btn {
	margin-bottom: 1.4rem;
	padding-top: 1.5rem;
	padding-bottom: 1.6rem;
	font-size: 2.2rem;
	letter-spacing: 0.4rem;
	text-align: left;
	padding-left: 3rem;
}

#menu .btn:hover, body.show-focus #menu .btn.nav-focus { transform: translateX(1.2rem); }
#menu .btn:active { transform: translateX(0.6rem) scale(0.98); }

.menu-gold {
	position: absolute;
	right: 2.2rem;
	top: 1.5rem;
	font-family: "GT Display";
	font-size: 2rem;
	color: #ffd98a;
}

.menu-gold .glyph { width: 2.4rem; height: 2.4rem; margin-right: 0.4rem; }

#footer {
	position: absolute;
	left: 10rem;
	right: 6rem;
	bottom: 5rem;
	display: flex;
	flex-direction: row;
	align-items: center;
	font-size: 1.5rem;
	color: #a99f8f;
}

#best { flex: 1 1 auto; }
#hints .keycap { margin-left: 1.6rem; }
#hints .padglyph { margin-left: 1.6rem; }

body.compact #intro { left: 5rem; top: 10rem; }
body.compact #footer { left: 5rem; }

/* ---------- phone: menu at the top left, best run at the bottom right, no key hints ---------- */

body.phone.title #intro { left: 4rem; top: 3rem; width: 56rem; }
body.phone #logo { width: 50rem; height: 7rem; }
body.phone #tagline { margin: 1rem 0 2.4rem 0.4rem; font-size: 1.6rem; letter-spacing: 0.4rem; }
body.phone #menu { width: 40rem; }
body.phone #menu .btn { margin-bottom: 1rem; padding-top: 1.9rem; padding-bottom: 2rem; font-size: 2.4rem; }
body.phone .menu-gold { top: 2rem; font-size: 2.2rem; }
body.phone .menu-gold .glyph { width: 2.6rem; height: 2.6rem; }
body.phone.title #footer { left: auto; right: 3rem; bottom: 2rem; width: 52rem; font-size: 1.8rem; text-align: right; }
body.phone #hints { display: none; }

/* Level-up card picker. Lengths in rem. */

/* A .screen-header (theme.rcss). */
#header {
	top: 12rem;
}

#title {
	font-size: 5.6rem;
	letter-spacing: 0.6rem;
	animation: 0.45s back-out title-in;
}

@keyframes title-in {
	0% { opacity: 0; transform: scale(1.4); }
	100% { opacity: 1; transform: scale(1); }
}

#cards {
	position: absolute;
	top: 24rem;
	left: 0;
	right: 0;
	display: flex;
	flex-direction: row;
	justify-content: center;
}

.card-slot {
	width: 30rem;
	margin: 0 1.6rem;
}

/* ---------- the card ---------- */

/* Its frame class (r-common...) colours the border (.rarity-border) and the rarity line (.rarity-text) in theme.rcss. */
.card {
	position: relative;
	height: 47rem;
	padding: 1.6rem 2rem 2rem 2rem;
	text-align: center;
	color: #ece4d4;
	decorator: vertical-gradient(#221b2cfa #0d0a12fc);
	border: 3dp #b8b8b8;
	border-radius: 1.2rem;
	box-shadow: #000000d0 0 1.6rem 4rem 0;
	transition: transform 0.14s cubic-out;
}

.card:hover, body.show-focus .card.nav-focus {
	transform: translateY(-0.8rem) scale(1.05);
}

.card:active { transform: translateY(-0.4rem) scale(1.0); }

body.show-focus .card.nav-focus {
	box-shadow: #000000d0 0 1.6rem 4rem 0, #ffffffc0 0 0 0 2dp, #ffffff50 0 0 2.4rem 0.4rem;
}

/* Rarity light from the top of the card. */
.card-glow {
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	height: 24rem;
	border-top-left-radius: 1rem;
	border-top-right-radius: 1rem;
	decorator: radial-gradient(circle at 50% 30%, #b8b8b838, #b8b8b800 70%);
}

.card.r-uncommon .card-glow { decorator: radial-gradient(circle at 50% 30%, #4ccb6a48, #4ccb6a00 70%); }
.card.r-rare .card-glow { decorator: radial-gradient(circle at 50% 30%, #4c8dff58, #4c8dff00 70%); }
.card.r-epic .card-glow { decorator: radial-gradient(circle at 50% 30%, #b05cff60, #b05cff00 70%); }
.card.r-boon .card-glow { decorator: radial-gradient(circle at 50% 30%, #6fdcb44a, #6fdcb400 70%); }
.card.r-evolution .card-glow {
	decorator: radial-gradient(circle at 50% 30%, #ffc94c70, #ffc94c00 72%);
	animation: 1.2s sine-in-out infinite alternate pulse-opacity;
}

.card-head {
	position: relative;
	height: 2.6rem;
}

.card-tag {
	display: inline-block;
	padding: 0.3rem 1rem 0.4rem 1rem;
	font-family: "GT Heavy";
	font-size: 1.3rem;
	letter-spacing: 0.15rem;
	color: #1c1006;
	background-color: #ffc94c;
	border-radius: 0.4rem;
}

.card-tag.rank { color: #ece4d4; background-color: #2e2638; border: 1dp #6b5530; }

.card-banish {
	position: absolute;
	right: -0.8rem;
	top: -0.4rem;
	width: 3rem;
	height: 3rem;
	border-radius: 1.5rem;
	border: 2dp #7a2a22;
	background-color: #2a0e0e;
	visibility: hidden;
}

.card-banish img { display: block; width: 1.8rem; height: 1.8rem; margin: 0.4rem; image-color: #ff8a7a; }
.card-banish:hover { border-color: #ff6a50; background-color: #4a1210; }
body.can-banish .card-banish { visibility: visible; }
body.can-banish .card.no-banish .card-banish { visibility: hidden; }

.card-icon-wrap {
	width: 12.8rem;
	height: 12.8rem;
	margin: 1.4rem auto 1.2rem auto;
}

.card-icon {
	display: block;
	width: 12.8rem;
	height: 12.8rem;
}

.card-name {
	font-family: "GT Display";
	font-size: 2.5rem;
	letter-spacing: 0.1rem;
	color: #ffffff;
	font-effect: outline(2dp #08060c);
}

.card-rarity {
	margin-top: 0.4rem;
	font-family: "GT Heavy";
	font-size: 1.25rem;
	letter-spacing: 0.3rem;
	color: #b8b8b8;
}

.card-own {
	height: 2.6rem;
	margin-top: 0.6rem;
}

.card-rule {
	height: 1.6rem;
	margin: 0.8rem 2rem;
	decorator: image("app:/data/UI/Art/divider.png");
}

.card-desc {
	min-height: 6rem;
	font-family: "GT Semi";
	font-size: 1.6rem;
	line-height: 2.4rem;
	color: #d8cfbf;
}

.card-desc .old { color: #a99f8f; }
.card-desc .arrow { color: #ffc94c; font-family: "GT Display"; }
.card-desc .new { color: #7fe39a; font-family: "GT Heavy"; }

.card-evo {
	position: absolute;
	left: 1.6rem;
	right: 1.6rem;
	bottom: 4.4rem;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	padding: 0.6rem;
	border-top: 1dp #6b553060;
	font-size: 1.3rem;
	color: #ffd98a;
}

.card-evo-icon {
	width: 3rem;
	height: 3rem;
	margin-right: 0.8rem;
}

.card-key {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 1.4rem;
	text-align: center;
}

/* A .flash-layer (theme.rcss), shown while a pick flashes the card. */
.card-flash {
	border-radius: 1rem;
	background-color: #ffffff;
	visibility: hidden;
}

.card.picked .card-flash {
	visibility: visible;
	animation: 0.35s cubic-out card-flash;
}

@keyframes card-flash {
	0% { opacity: 0.9; }
	100% { opacity: 0; }
}

.card.picked { transform: translateY(-1.2rem) scale(1.08); }

/* ---------- actions ---------- */

#actions {
	position: absolute;
	left: 0;
	right: 0;
	top: 75rem;
	display: flex;
	flex-direction: row;
	justify-content: center;
	align-items: center;
}

#actions .btn { margin: 0 1.4rem; min-width: 20rem; }
#actions .glyph { width: 2rem; height: 2rem; margin-left: 0.4rem; }

#banish-hint {
	margin: 0 1.4rem;
	font-family: "GT Heavy";
	font-size: 1.6rem;
	letter-spacing: 0.2rem;
	color: #a99f8f;
}

#banish-hint .count { font-family: "GT Display"; color: #ff8a7a; margin-left: 0.6rem; }
body.no-banish-left #banish-hint { color: #5a5260; }

/* ---------- the picked icon flying to its HUD slot ---------- */

#fly {
	position: absolute;
	left: 0;
	top: 0;
	width: 12.8rem;
	height: 12.8rem;
	visibility: hidden;
}

/* Short screens: cards shrink so the actions stay visible. */
body.short #header { top: 10.5rem; }
body.short #title { font-size: 4.2rem; }
body.short #cards { top: 18rem; }
body.short .card { height: 44rem; }
body.short #actions { top: 64rem; }
body.compact .card-slot { width: 26rem; margin: 0 1rem; }

/* ---------- phone: three cards of a fixed size, centered under the title ---------- */

body.phone #header { top: 0.8rem; }
body.phone #title { font-size: 3.6rem; letter-spacing: 0.4rem; }
body.phone #subtitle { display: none; }
body.phone #cards { top: 7rem; align-items: flex-start; }
body.phone .card-slot { width: 30rem; height: auto; margin: 0 1rem; }
body.phone .card {
	height: 36rem;
	box-sizing: border-box;
	padding: 1rem 1.4rem;
	display: flex;
	flex-direction: column;
}
body.phone .card:hover, body.phone.show-focus .card.nav-focus { transform: scale(1.02); }
body.phone .card.picked { transform: scale(1.04); }
body.phone .card-head { height: 2.8rem; }
body.phone .card-tag { font-size: 1.7rem; }
body.phone .card-banish { width: 5.4rem; height: 5.4rem; border-radius: 2.7rem; right: -1rem; top: -1rem; }
body.phone .card-banish img { width: 3rem; height: 3rem; margin: 1.2rem; }
body.phone .card-icon-wrap { width: 7rem; height: 7rem; margin: 0.4rem auto 0.4rem auto; }
body.phone .card-icon { width: 7rem; height: 7rem; }
body.phone .card-name { font-size: 2.2rem; }
body.phone .card-rarity { margin-top: 0.2rem; font-size: 1.6rem; letter-spacing: 0.15rem; }
body.phone .card-own { height: 3.2rem; margin-top: 0.4rem; }
body.phone .card-rule { height: 1.2rem; margin: 0.3rem 2rem; }
body.phone .card-desc { flex: 1 1 0; min-height: 0; overflow: hidden; font-size: 1.7rem; line-height: 2.2rem; }
body.phone .card-evo { position: relative; left: auto; right: auto; bottom: auto; flex: 0 0 auto; margin-top: 0.4rem; padding: 0.4rem; font-size: 1.6rem; }
body.phone .card-evo-icon { width: 3rem; height: 3rem; }
body.phone .card-key { display: none; }
body.phone #actions { top: auto; bottom: 1rem; }
body.phone #actions .btn { min-width: 22rem; margin: 0 1rem; }

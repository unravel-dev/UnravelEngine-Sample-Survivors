<html>
<head>
    <title>Barrowlight Results</title>
    <link type="text/rcss" href="engine:/data/ui/rml.rcss"/>
    <link type="text/rcss" href="app:/data/UI/theme.rcss"/>
    <link type="text/rcss" href="app:/data/UI/Results.rcss"/>
    <link type="text/rcss" href="app:/data/UI/phone.rcss"/>
</head>
<!--
    Game over / victory. Model "results" is ResultsModel (ResultsScreen.cs); the weapon table repeats one row
    per ResultRow (sorted by damage; the share bar's width comes in as its inline style).
-->
<body data-model="results" class="results">
    <div class="dim heavy"/>
    <div id="victory-glow" class="fill" data-class-on="victory"/>
    <div class="safe">
        <div id="intro" class="fill">
            <div id="res-banner" class="screen-header" data-class-victory="victory">
                <div id="res-title">{{ title }}</div>
                <div id="res-sub">{{ subtitle }}</div>
            </div>

            <div id="tiles">
                <div class="tile">
                    <img class="glyph" src="app:/data/UI/Icons/timer.png"/>
                    <div class="tile-value">{{ time }}</div>
                    <div class="tile-label">SURVIVED</div>
                </div>
                <div class="tile">
                    <img class="glyph" src="app:/data/UI/Icons/xp.png"/>
                    <div class="tile-value">{{ level }}</div>
                    <div class="tile-label">LEVEL</div>
                </div>
                <div class="tile">
                    <img class="glyph" src="app:/data/UI/Icons/skull.png"/>
                    <div class="tile-value">{{ kills }}</div>
                    <div class="tile-label">KILLS</div>
                </div>
                <div class="tile gold-tile">
                    <img class="glyph" src="app:/data/UI/Icons/gold.png"/>
                    <div class="tile-value">{{ gold }}</div>
                    <div class="tile-label">{{ goldLabel }}</div>
                </div>
            </div>

            <div id="table-panel" class="panel">
                <div class="corner tl"/><div class="corner tr"/><div class="corner bl"/><div class="corner br"/>
                <div class="table-row table-head">
                    <span class="c-name">WEAPON</span>
                    <span class="c-num">DAMAGE</span>
                    <span class="c-num">DPS</span>
                    <span class="c-num">KILLS</span>
                    <span class="c-num">OWNED</span>
                </div>
                <div id="table-body">
                    <div class="table-row" data-for="r : rows" data-class-top="r.top" data-class-evolved="r.evolved">
                        <span class="c-name"><img class="t-icon" data-attr-src="r.icon"/><span class="t-name">{{ r.name }}</span><span data-attr-class="r.ownClasses"><img class="own-emblem" data-attr-src="r.ownEmblem"/><span class="own-text">{{ r.ownText }}</span></span></span>
                        <span class="c-num">{{ r.damage }}</span>
                        <span class="c-num">{{ r.dps }}</span>
                        <span class="c-num">{{ r.kills }}</span>
                        <span class="c-num">{{ r.owned }}</span>
                        <div class="share"><div class="share-fill" data-attr-style="r.shareStyle"/></div>
                    </div>
                    <div class="table-row" data-if="rows.size == 0"><span class="c-name muted"><span class="t-name">No damage dealt.</span></span></div>
                </div>
                <div id="res-extra">{{ extra }}</div>
            </div>

            <div id="res-news" data-class-has="news != ''">{{ news }}</div>

            <div id="res-actions">
                <div class="btn primary nav" data-event-click="Retry()">RETRY</div>
                <div class="btn nav" data-event-click="HeroSelect()">HERO SELECT</div>
                <div class="btn nav" data-event-click="Armory()">ARMORY</div>
                <div class="btn nav" data-event-click="Title()">TITLE</div>
            </div>
        </div>
    </div>
</body>
</html>

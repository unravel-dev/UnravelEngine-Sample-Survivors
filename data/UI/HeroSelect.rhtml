<html>
<head>
    <title>Barrowlight Hero Select</title>
    <link type="text/rcss" href="engine:/data/ui/rml.rcss"/>
    <link type="text/rcss" href="app:/data/UI/theme.rcss"/>
    <link type="text/rcss" href="app:/data/UI/HeroSelect.rcss"/>
    <link type="text/rcss" href="app:/data/UI/phone.rcss"/>
</head>
<!--
    Hero select. Model "heroes" is HeroSelectModel (HeroSelectScreen.cs): four cards from HeroCatalog with
    stat bars, signature passive, active and starting weapon; locked heroes show the unlock hint; the Dread
    selector appears after the first victory.
-->
<body data-model="heroes" class="heroes">
    <div class="dim"/>
    <div class="safe">
        <div id="intro" class="fill">
            <div id="hs-header" class="screen-header">
                <div class="heading">CHOOSE YOUR HERO</div>
                <div class="subheading">EVERY OATH BREAKS DIFFERENTLY</div>
            </div>

            <div id="hero-row">
                <div class="hero-card nav" data-for="h, i : heroes" data-class-locked="h.locked" data-class-selected="i == selected" data-event-click="Select(i)">
                    <div class="hero-portrait">
                        <img class="portrait" data-attr-src="h.portrait"/>
                        <div class="hero-lock" data-if="h.locked"><img src="app:/data/UI/Icons/lock.png"/></div>
                        <div class="hero-skulls" data-if="h.hasSkulls">
                            <div class="skull" data-for="s : h.skulls" data-class-on="s"><span class="fill-marker"/></div>
                        </div>
                    </div>
                    <div class="hero-name">{{ h.name }}</div>
                    <div class="hero-title">{{ h.title }}</div>
                    <div class="hero-stats">
                        <div class="stat-row">
                            <span class="stat-label">HEALTH</span>
                            <div class="segs"><div class="seg" data-for="on : h.hp" data-class-on="on"><span class="fill-marker"/></div></div>
                            <span class="stat-value">{{ h.hpText }}</span>
                        </div>
                        <div class="stat-row">
                            <span class="stat-label">ARMOR</span>
                            <div class="segs"><div class="seg" data-for="on : h.armor" data-class-on="on"><span class="fill-marker"/></div></div>
                            <span class="stat-value">{{ h.armorText }}</span>
                        </div>
                        <div class="stat-row">
                            <span class="stat-label">SPEED</span>
                            <div class="segs"><div class="seg" data-for="on : h.speed" data-class-on="on"><span class="fill-marker"/></div></div>
                            <span class="stat-value">{{ h.speedText }}</span>
                        </div>
                    </div>
                    <div class="hero-abilities" data-if="!h.locked">
                        <div class="ability">
                            <img class="ability-icon" data-attr-src="h.weaponIcon"/>
                            <div class="ability-body">
                                <div class="ability-kind">STARTING WEAPON</div>
                                <div class="ability-name">{{ h.weaponName }}</div>
                            </div>
                        </div>
                        <div class="ability">
                            <img class="ability-icon" data-attr-src="h.passiveIcon"/>
                            <div class="ability-body">
                                <div class="ability-kind">SIGNATURE</div>
                                <div class="ability-name">{{ h.passiveName }}</div>
                                <div class="ability-text">{{ h.passiveText }}</div>
                            </div>
                        </div>
                        <div class="ability">
                            <img class="ability-icon" data-attr-src="h.activeIcon"/>
                            <div class="ability-body">
                                <div class="ability-kind">ACTIVE</div>
                                <div class="ability-name">{{ h.activeName }}</div>
                                <div class="ability-text">{{ h.activeText }}</div>
                            </div>
                        </div>
                    </div>
                    <div class="hero-hint" data-if="h.locked">
                        <div class="hint-title">LOCKED</div>
                        <div class="hint-text">{{ h.hint }}</div>
                        <div class="hint-progress">{{ h.progress }}</div>
                    </div>
                    <div class="hero-best" data-if="!h.locked">{{ h.best }}</div>
                </div>
            </div>

            <div id="hs-bottom">
                <div class="btn nav" data-event-click="Back()">
                    <span class="hint"><span class="keycap kbd-only">ESC</span><img class="padglyph pad-only" src="app:/data/UI/Glyphs/buttonB.png"/></span>BACK
                </div>
                <div id="dread" data-if="dreadUnlocked">
                    <div class="btn small nav dread-step" data-event-click="DreadDown()">-</div>
                    <div id="dread-value">
                        <div id="dread-label">DREAD {{ dread }}</div>
                        <div id="dread-text">{{ dreadText }}</div>
                    </div>
                    <div class="btn small nav dread-step" data-event-click="DreadUp()">+</div>
                </div>
                <div id="hs-start" class="btn primary nav" data-class-disabled="!canStart" data-event-click="Start()">
                    <span class="hint"><span class="keycap kbd-only">ENTER</span><img class="padglyph pad-only" src="app:/data/UI/Glyphs/buttonA.png"/></span>{{ startText }}
                </div>
            </div>
        </div>
    </div>
</body>
</html>

<html>
<head>
    <title>Barrowlight Armory</title>
    <link type="text/rcss" href="engine:/data/ui/rml.rcss"/>
    <link type="text/rcss" href="app:/data/UI/theme.rcss"/>
    <link type="text/rcss" href="app:/data/UI/Armory.rcss"/>
    <link type="text/rcss" href="app:/data/UI/phone.rcss"/>
</head>
<!--
    Armory, the meta shop. Model "armory" is ArmoryModel (ArmoryScreen.cs): one tile per MetaShop upgrade with
    rank pips, current bonus, next rank and price (MetaShop.GetPrice); click / Submit opens the inspect panel
    (what the upgrade does, every rank, Buy); Refund all (asked twice) returns every coin spent.
-->
<body data-model="armory" class="armory">
    <div class="dim heavy"/>
    <div class="safe">
        <div id="intro" class="fill">
            <div id="arm-header" class="screen-header">
                <div class="heading">ARMORY</div>
                <div class="subheading">GRAVE GOLD BUYS WHAT EVERY RUN BEGINS WITH</div>
                <div id="arm-gold"><img class="glyph" src="app:/data/UI/Icons/gold.png"/><span>{{ gold }}</span></div>
            </div>

            <div id="arm-grid">
                <div class="upgrade nav" data-for="u, i : items" data-class-maxed="u.maxed" data-class-unowned="!u.owned" data-class-poor="!u.affordable" data-event-click="Inspect(i)">
                    <img class="up-icon" data-attr-src="u.icon"/>
                    <div class="up-body">
                        <div class="up-name">{{ u.name }}</div>
                        <div class="pips up-pips"><div class="pip" data-for="p : u.pips" data-class-on="p"><span class="fill-marker"/></div></div>
                        <div class="up-effect">{{ u.effect }}</div>
                        <div class="up-next">{{ u.next }}</div>
                    </div>
                    <div class="up-price">
                        <img class="glyph" src="app:/data/UI/Icons/gold.png" data-if="!u.maxed"/>
                        <span>{{ u.price }}</span>
                    </div>
                </div>
            </div>

            <div id="arm-footer">
                <div class="btn nav" data-event-click="Back()">
                    <span class="hint"><span class="keycap kbd-only">ESC</span><img class="padglyph pad-only" src="app:/data/UI/Glyphs/buttonB.png"/></span>BACK
                </div>
                <div id="arm-message">{{ message }}</div>
                <div id="refund" class="btn danger nav" data-class-confirm="confirmRefund" data-event-click="Refund()">{{ refundText }}</div>
            </div>
        </div>
    </div>

    <div id="inspect" data-if="inspecting">
        <div class="dim" data-event-click="CloseInspect()"/>
        <div class="safe">
            <div id="inspect-panel" class="panel">
                <div class="corner tl"/><div class="corner tr"/><div class="corner bl"/><div class="corner br"/>
                <div id="inspect-close" class="close-button nav" data-event-click="CloseInspect()"><img src="app:/data/UI/Glyphs/cross.png"/></div>
                <div id="inspect-main">
                    <div id="inspect-info">
                        <img id="inspect-icon" data-attr-src="inspectIcon"/>
                        <div id="inspect-name">{{ inspectName }}</div>
                        <div id="inspect-rank">{{ inspectRank }}</div>
                        <div id="inspect-desc">{{ inspectSummary }}</div>
                    </div>
                    <div id="inspect-ranks">
                        <div id="inspect-ranks-label" class="label">BONUS BY RANK</div>
                        <div class="rank-row" data-for="r : inspectRanks" data-class-owned="r.owned" data-class-next="r.next">
                            <div class="pip" data-class-on="r.owned"><span class="fill-marker"/></div>
                            <div class="rank-label">{{ r.label }}</div>
                            <div class="rank-bonus">{{ r.bonus }}</div>
                        </div>
                    </div>
                </div>
                <div id="inspect-footer">
                    <div id="inspect-gold"><img class="glyph" src="app:/data/UI/Icons/gold.png"/>{{ gold }}</div>
                    <div id="inspect-message">{{ message }}</div>
                    <div id="inspect-forged" data-if="inspectMaxed">FULLY FORGED</div>
                    <div id="inspect-buy" class="btn primary nav" data-if="!inspectMaxed" data-class-poor="!inspectAffordable" data-event-click="Buy()">
                        {{ buyText }}<img class="glyph" src="app:/data/UI/Icons/gold.png"/>{{ inspectPrice }}
                    </div>
                </div>
                <div id="inspect-flash" class="flash-layer"/>
            </div>
        </div>
    </div>
</body>
</html>

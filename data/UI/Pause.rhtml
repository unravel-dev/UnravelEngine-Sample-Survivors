<html>
<head>
    <title>Barrowlight Pause</title>
    <link type="text/rcss" href="engine:/data/ui/rml.rcss"/>
    <link type="text/rcss" href="app:/data/UI/theme.rcss"/>
    <link type="text/rcss" href="app:/data/UI/Pause.rcss"/>
    <link type="text/rcss" href="app:/data/UI/phone.rcss"/>
</head>
<!--
    Pause / build summary. Model "pause" is PauseModel (PauseScreen.cs): weapons with rank and damage line,
    passives and boons with their effect, the full stat sheet (armor as % reduction), Resume / Settings /
    Abandon (asks twice).
-->
<body data-model="pause" class="pause">
    <div class="dim"/>
    <div class="safe">
        <div id="intro" class="fill">
            <div id="pause-header" class="screen-header">
                <div class="heading">PAUSED</div>
                <div class="subheading">{{ summary }}</div>
            </div>

            <div id="pause-body">
                <div id="build" class="panel">
                    <div class="corner tl"/><div class="corner tr"/><div class="corner bl"/><div class="corner br"/>
                    <div class="label section">WEAPONS</div>
                    <div class="weapon-row" data-for="w : weapons" data-class-evolved="w.evolved">
                        <img class="row-icon" data-attr-src="w.icon"/>
                        <div class="row-body">
                            <div class="row-top">
                                <span class="row-name">{{ w.name }}</span>
                                <span class="row-rank">{{ w.rank }}</span>
                            </div>
                            <div class="row-line"><span data-attr-class="w.ownClasses"><img class="own-emblem" data-attr-src="w.ownEmblem"/><span class="own-text">{{ w.ownText }}</span></span>{{ w.line }}</div>
                        </div>
                    </div>
                    <div class="label section second">PASSIVES AND BOONS</div>
                    <div id="passive-grid">
                        <div class="passive-row" data-for="p : passives">
                            <img class="row-icon small" data-attr-src="p.icon"/>
                            <div class="row-body">
                                <div class="row-top">
                                    <span class="row-name">{{ p.name }}</span>
                                    <span class="row-rank">{{ p.rank }}</span>
                                </div>
                                <div class="row-line"><span data-attr-class="p.ownClasses"><img class="own-emblem" data-attr-src="p.ownEmblem"/><span class="own-text">{{ p.ownText }}</span></span>{{ p.line }}</div>
                            </div>
                        </div>
                    </div>
                    <div class="empty-note" data-if="passives.size == 0">No passives yet.</div>
                </div>

                <div id="stats" class="panel">
                    <div class="corner tl"/><div class="corner tr"/><div class="corner bl"/><div class="corner br"/>
                    <div class="label section">STATS</div>
                    <div class="stat-line" data-for="s : stats" data-class-boosted="s.boosted">
                        <span class="stat-name">{{ s.name }}</span>
                        <span class="stat-value">{{ s.value }}</span>
                    </div>
                </div>

                <div id="pause-actions">
                    <div class="btn primary nav" data-event-click="Resume()">
                        <span class="hint"><span class="keycap kbd-only">ESC</span><img class="padglyph pad-only" src="app:/data/UI/Glyphs/buttonStart.png"/></span>RESUME
                    </div>
                    <div class="btn nav" data-event-click="Settings()">SETTINGS</div>
                    <div id="abandon" class="btn danger nav" data-class-confirm="confirmAbandon" data-event-click="Abandon()">{{ abandonText }}</div>
                    <div id="pause-damage" class="muted">{{ damageNote }}</div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>

/* Armory. Lengths in rem. */

/* A .fill (theme.rcss): spans the safe area so rows can anchor to its bottom. */
#intro {
	animation: 0.4s cubic-out screen-in;
}

/* A .screen-header (theme.rcss). */
#arm-header {
	top: 5rem;
}

#arm-gold {
	display: inline-block;
	margin-top: 1.4rem;
	padding: 0.6rem 2.4rem;
	font-family: "GT Display";
	font-size: 3rem;
	color: #ffd98a;
	decorator: linear-gradient(to right, #0c0a1200, #0c0a12e0, #0c0a1200);
	font-effect: outline(2dp #140a04);
}

#arm-gold .glyph { width: 3.4rem; height: 3.4rem; margin-right: 0.8rem; }

/* Seven tiles a row; scrolls when a large UI scale leaves less room than two rows. */
#arm-grid {
	position: absolute;
	top: 25rem;
	bottom: 13rem;
	left: 50%;
	width: 174rem;
	margin-left: -87rem;
	overflow-y: auto;
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	justify-content: center;
	align-content: flex-start;
}

.upgrade {
	position: relative;
	width: 20rem;
	height: 27rem;
	margin: 0 0.6rem 1.4rem 0.6rem;
	padding: 1.2rem;
	text-align: center;
	decorator: vertical-gradient(#1e1828f4 #0c0a11f8);
	border: 2dp #4a3e2c;
	border-radius: 1rem;
	box-shadow: #000000b0 0 0.8rem 2rem 0;
	transition: transform 0.12s cubic-out;
}

.upgrade:hover, body.show-focus .upgrade.nav-focus { transform: translateY(-0.6rem) scale(1.03); border-color: #c9a45c; }
.upgrade:active { transform: scale(0.98); }
.upgrade.maxed { border-color: #ffc94c; }
.upgrade.unowned .up-effect { color: #8d8494; }

.up-icon {
	display: block;
	width: 7.2rem;
	height: 7.2rem;
	margin: 0 auto 0.6rem auto;
}

.up-name {
	font-family: "GT Display";
	font-size: 1.8rem;
	letter-spacing: 0.1rem;
	color: #ffffff;
	font-effect: outline(2dp #08060c);
}

.up-pips { margin: 0.8rem 0; }
.up-pips .pip { width: 0.8rem; height: 0.8rem; margin: 0 0.3rem; }

.up-effect {
	font-family: "GT Heavy";
	font-size: 1.35rem;
	color: #7fe39a;
	min-height: 1.8rem;
}

.up-next {
	font-size: 1.2rem;
	color: #a99f8f;
	min-height: 1.8rem;
}

.up-price {
	position: absolute;
	left: 1.2rem;
	right: 1.2rem;
	bottom: 1.2rem;
	padding: 0.6rem 0;
	font-family: "GT Display";
	font-size: 1.8rem;
	color: #ffd98a;
	border-radius: 0.6rem;
	background-color: #00000070;
	border: 1dp #6b553080;
}

.up-price .glyph { width: 2rem; height: 2rem; margin-right: 0.4rem; }
.upgrade.poor .up-price { color: #8a6a6a; }
.upgrade.maxed .up-price { color: #ffc94c; background-color: #ffc94c18; }

#arm-footer {
	position: absolute;
	bottom: 5rem;
	left: 50%;
	width: 140rem;
	margin-left: -70rem;
	display: flex;
	flex-direction: row;
	align-items: center;
}

#arm-message {
	flex: 1 1 auto;
	text-align: center;
	font-size: 1.6rem;
	color: #a99f8f;
}

#refund.confirm { color: #ffd0c8; border-color: #ff6a50; decorator: vertical-gradient(#4a1a18 #24100e); }

body.short #arm-header { top: 1.5rem; }
body.short #arm-header .subheading { display: none; }
body.short #arm-grid { top: 13rem; bottom: 9rem; }
body.short .upgrade { height: 25rem; margin-bottom: 1rem; }
body.short #arm-footer { bottom: 1.5rem; }
body.compact #arm-grid { width: 140rem; margin-left: -70rem; }
body.compact .upgrade { width: 18.2rem; margin: 0 0.4rem 1.2rem 0.4rem; }
body.compact .up-name { font-size: 1.5rem; }
body.compact #arm-footer { width: 120rem; margin-left: -60rem; }

/* ---------- inspect panel: what an upgrade does, every rank, Buy ---------- */

/* Centers the panel; taps outside it reach the dim, which closes it. */
#inspect .safe {
	display: flex;
	align-items: center;
	justify-content: center;
	pointer-events: none;
}

/* Opaque, unlike other panels: the tiles behind would show through it. */
#inspect-panel {
	width: 100rem;
	padding: 2.6rem 3rem 2.2rem 3rem;
	decorator: vertical-gradient(#1e1828 #0c0a11);
	pointer-events: auto;
	animation: 0.25s back-out inspect-in;
}

/* A pop without a fade: a fading panel shows the grid through it, its icon behind its own background. */
@keyframes inspect-in {
	0% { transform: scale(0.92); }
	100% { transform: scale(1); }
}

/* A .close-button (theme.rcss). */
#inspect-close {
	right: 1.2rem;
	top: 1.2rem;
}

#inspect-main {
	display: flex;
	flex-direction: row;
}

#inspect-info {
	flex: 0 0 auto;
	width: 40rem;
	padding-right: 3rem;
	text-align: center;
}

#inspect-icon {
	display: block;
	width: 12rem;
	height: 12rem;
	margin: 0 auto 1rem auto;
}

#inspect-name {
	font-family: "GT Display";
	font-size: 3.4rem;
	letter-spacing: 0.15rem;
	color: #ffffff;
	font-effect: outline(2dp #08060c);
}

#inspect-rank {
	margin-top: 0.4rem;
	font-family: "GT Heavy";
	font-size: 1.5rem;
	letter-spacing: 0.2rem;
	color: #c9a45c;
}

#inspect-desc {
	margin-top: 1.4rem;
	font-family: "GT Semi";
	font-size: 1.8rem;
	line-height: 2.6rem;
	color: #ece4d4;
}

#inspect-ranks {
	flex: 1 1 auto;
	padding-left: 3rem;
	border-left: 1dp #6b553060;
}

/* Leaves the close button room above the first rank. */
#inspect-ranks-label { display: block; margin-bottom: 2.2rem; }

.rank-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 4.2rem;
	padding: 0 1.4rem;
	margin-bottom: 0.6rem;
	border: 1dp #00000000;
	border-radius: 0.6rem;
	background-color: #00000048;
}

.rank-row .pip { width: 1rem; height: 1rem; margin: 0 1.4rem 0 0.2rem; }

.rank-label {
	flex: 0 0 auto;
	width: 10rem;
	font-family: "GT Heavy";
	font-size: 1.4rem;
	letter-spacing: 0.15rem;
	color: #7d7484;
}

.rank-bonus {
	flex: 1 1 auto;
	font-family: "GT Heavy";
	font-size: 1.8rem;
	color: #8d8494;
}

.rank-row.owned .rank-label { color: #c8bfaf; }
.rank-row.owned .rank-bonus { color: #7fe39a; }
.rank-row.next { border-color: #ffc94c90; background-color: #ffc94c18; }
.rank-row.next .rank-label, .rank-row.next .rank-bonus { color: #ffd98a; }

#inspect-footer {
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-top: 2rem;
	padding-top: 1.6rem;
	border-top: 1dp #6b553060;
}

#inspect-gold {
	flex: 0 0 auto;
	font-family: "GT Display";
	font-size: 2.4rem;
	color: #ffd98a;
	font-effect: outline(2dp #140a04);
}

#inspect-gold .glyph { width: 2.8rem; height: 2.8rem; margin-right: 0.6rem; }

#inspect-message {
	flex: 1 1 auto;
	padding: 0 2rem;
	text-align: center;
	font-size: 1.6rem;
	color: #a99f8f;
}

#inspect-buy { flex: 0 0 auto; min-width: 30rem; font-size: 2rem; }
#inspect-buy .glyph { width: 2.4rem; height: 2.4rem; margin: 0 0.4rem 0 1.6rem; }
#inspect-buy.poor, #inspect-buy.poor:hover { color: #8a7a6a; border-color: #5a4a32; decorator: vertical-gradient(#3a3020 #241c12); }
body.show-focus #inspect-buy.poor.nav-focus { border-color: #c9a45c; }

#inspect-forged {
	flex: 0 0 auto;
	padding: 1.2rem 2rem;
	font-family: "GT Display";
	font-size: 2.2rem;
	letter-spacing: 0.2rem;
	color: #ffc94c;
}

/* A gold wash over the panel when a rank is bought: a .flash-layer (theme.rcss). */
#inspect-flash {
	border-radius: 0.9rem;
	background-color: #ffd98a;
	pointer-events: none;
}

#inspect-flash.flash { animation: 0.45s cubic-out buy-flash; }

@keyframes buy-flash {
	0% { opacity: 0.35; }
	100% { opacity: 0; }
}

/* ---------- phone: two columns of rows, scrolling ---------- */

body.phone #arm-header { top: 0.6rem; left: 2rem; right: 2rem; text-align: left; }
body.phone #arm-header .heading { display: inline-block; font-size: 3.2rem; text-align: left; }
body.phone #arm-header .subheading { display: none; }
body.phone #arm-gold { position: absolute; right: 0; top: 0; margin-top: 0; padding: 0.4rem 1.6rem; font-size: 2.8rem; }
body.phone #arm-grid {
	top: 6.4rem;
	bottom: 9rem;
	left: 2rem;
	right: 2rem;
	width: auto;
	margin-left: 0;
	overflow-y: auto;
	justify-content: space-between;
	align-content: flex-start;
}
body.phone .upgrade {
	width: 49%;
	height: auto;
	margin: 0 0 0.8rem 0;
	padding: 0.8rem 1.2rem;
	box-sizing: border-box;
	display: flex;
	flex-direction: row;
	align-items: center;
	text-align: left;
}
body.phone .upgrade:hover, body.phone.show-focus .upgrade.nav-focus { transform: none; }
body.phone .up-icon { width: 5.2rem; height: 5.2rem; margin: 0 1.2rem 0 0; flex: 0 0 auto; }
body.phone .up-body { flex: 1 1 auto; }
body.phone .up-name { font-size: 2rem; }
body.phone .up-pips { justify-content: flex-start; margin: 0.4rem 0; }
body.phone .up-effect { min-height: 0; font-size: 1.7rem; }
body.phone .up-next { display: none; }
body.phone .up-price {
	position: static;
	flex: 0 0 auto;
	width: 12rem;
	margin-left: 1rem;
	padding: 1.2rem 0;
	font-size: 2rem;
	text-align: center;
}
body.phone #arm-footer { top: auto; bottom: 1rem; left: 2rem; right: 2rem; width: auto; margin-left: 0; }
body.phone #arm-message { font-size: 1.8rem; }
body.phone #inspect-panel { width: 108rem; padding: 2rem 2.4rem 1.8rem 2.4rem; }
body.phone #inspect-close { width: 5.6rem; height: 5.6rem; border-radius: 2.8rem; }
body.phone #inspect-close img { width: 2.8rem; height: 2.8rem; margin: 1.2rem; }
body.phone #inspect-info { width: 44rem; }
body.phone #inspect-icon { width: 10rem; height: 10rem; }
body.phone #inspect-name { font-size: 3rem; }
body.phone #inspect-rank { font-size: 1.7rem; }
body.phone #inspect-desc { font-size: 2rem; line-height: 2.8rem; }
body.phone #inspect-ranks-label { margin-bottom: 3rem; font-size: 1.6rem; }
body.phone .rank-row { height: 4.4rem; }
body.phone .rank-label { width: 11rem; font-size: 1.6rem; }
body.phone .rank-bonus { font-size: 2rem; }
body.phone #inspect-message { font-size: 1.8rem; }
body.phone #inspect-buy { min-width: 32rem; font-size: 2.2rem; padding-top: 1.6rem; padding-bottom: 1.7rem; }

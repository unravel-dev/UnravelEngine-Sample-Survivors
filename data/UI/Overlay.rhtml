<html>
<head>
    <title>Barrowlight Overlay</title>
    <link type="text/rcss" href="engine:/data/ui/rml.rcss"/>
    <link type="text/rcss" href="app:/data/UI/theme.rcss"/>
    <link type="text/rcss" href="app:/data/UI/Overlay.rcss"/>
    <link type="text/rcss" href="app:/data/UI/phone.rcss"/>
</head>
<!--
    Everything drawn over the world during play, written by OverlayScreen.cs (its widgets HeroVitals,
    WorldMarkers, BossBar, EventTracker, BannerQueue) and DamageNumbers.cs: low-health vignette, screen flash,
    damage numbers (pooled in #numbers), the hero health bar, elite bars, off-screen markers, edge danger
    chevrons, the boss bar, the map event tracker and event banners. Nothing here takes the pointer.
-->
<body class="overlay">
    <div id="vignette" class="fill">
        <div id="vignette-img" class="fill"/>
    </div>
    <div id="flash" class="flash-layer"/>

    <div id="numbers" class="fill"/>

    <div id="herobar">
        <progress id="herobar-fill" direction="right" value="1"/>
    </div>

    <div id="elitebars" class="fill">
        <div class="elitebar"><progress class="elitebar-fill" direction="right" value="1"/></div>
        <div class="elitebar"><progress class="elitebar-fill" direction="right" value="1"/></div>
        <div class="elitebar"><progress class="elitebar-fill" direction="right" value="1"/></div>
        <div class="elitebar"><progress class="elitebar-fill" direction="right" value="1"/></div>
        <div class="elitebar"><progress class="elitebar-fill" direction="right" value="1"/></div>
        <div class="elitebar"><progress class="elitebar-fill" direction="right" value="1"/></div>
        <div class="elitebar"><progress class="elitebar-fill" direction="right" value="1"/></div>
        <div class="elitebar"><progress class="elitebar-fill" direction="right" value="1"/></div>
    </div>

    <div id="markers" class="fill">
        <div class="marker"><div class="marker-arrow"/><img class="marker-icon" src="app:/data/UI/Icons/skull.png"/></div>
        <div class="marker"><div class="marker-arrow"/><img class="marker-icon" src="app:/data/UI/Icons/skull.png"/></div>
        <div class="marker"><div class="marker-arrow"/><img class="marker-icon" src="app:/data/UI/Icons/skull.png"/></div>
        <div class="marker"><div class="marker-arrow"/><img class="marker-icon" src="app:/data/UI/Icons/skull.png"/></div>
        <div class="marker"><div class="marker-arrow"/><img class="marker-icon" src="app:/data/UI/Icons/skull.png"/></div>
        <div class="marker"><div class="marker-arrow"/><img class="marker-icon" src="app:/data/UI/Icons/skull.png"/></div>
        <div class="marker"><div class="marker-arrow"/><img class="marker-icon" src="app:/data/UI/Icons/skull.png"/></div>
        <div class="marker"><div class="marker-arrow"/><img class="marker-icon" src="app:/data/UI/Icons/skull.png"/></div>
    </div>

    <div id="edges" class="fill">
        <div class="edge"><div class="edge-chevrons"/></div>
        <div class="edge"><div class="edge-chevrons"/></div>
        <div class="edge"><div class="edge-chevrons"/></div>
        <div class="edge"><div class="edge-chevrons"/></div>
    </div>

    <div class="safe">
        <div id="bossbar">
            <div id="boss-title">THE HOLLOW KING</div>
            <div id="boss-name">Hollow King</div>
            <div id="boss-frame">
                <progress id="boss-ghost" direction="right" value="1"/>
                <progress id="boss-fill" direction="right" value="1"/>
                <div id="boss-pips"/>
                <div id="boss-shards">
                    <div class="shard s0"/><div class="shard s1"/><div class="shard s2"/><div class="shard s3"/><div class="shard s4"/>
                </div>
            </div>
        </div>

        <div id="event">
            <div id="event-head">
                <img id="event-icon" src="app:/data/UI/Icons/chest.png"/>
                <div id="event-title">SHRINE OF VIGIL</div>
                <div id="event-time" class="number">0:30</div>
            </div>
            <div id="event-goal">Hold the ring for 10 seconds.</div>
            <div id="event-frame"><progress id="event-fill" direction="right" value="0"/></div>
        </div>

        <div id="banner">
            <div id="banner-inner">
                <div id="banner-line-top"/>
                <div id="banner-text">THE GROUND SPLITS</div>
                <div id="banner-line-bottom"/>
            </div>
        </div>
    </div>
</body>
</html>

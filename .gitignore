# Rebuilt by the editor from data/
/compiled/
/cache/
/temp/

# Generated script projects, their build output and IDE state
/*.csproj
/*.sln
/bin/
/obj/
*.user
*.suo
/.vs/
/.vscode/
/.idea/

# Each user's editor state: open scene, gizmos, deploy profile, thumbnails, trash
/editor/

# Deploy output and kept release packs. releases/ cannot be rebuilt: archive it elsewhere.
/.deploy/
/releases/

# Signing keys never belong in the repository
*.keystore
*.jks

# Left behind by an interrupted save
*.temp

# Operating systems
.DS_Store
Thumbs.db
desktop.ini

# Development tool output and local backups (dev/README.md)
dev/shots/
dev/save_backup/
dev/check/bin/
dev/check/obj/
dev/audio_work/cache/
dev/audio_work/preview/
dev/tools/out/
dev/audio_work/tools/*.exe
dev/capture_*.png
dev/editor.lock
__pycache__/
*.log
